# Dependencies - reinstalled via npm install
node_modules/

# Build output - regenerated via npm run build
out/

# Packaged app - regenerated via electron-builder (installers are ~80MB+)
dist-desktop/

# Staged update files - regenerated by "npm run release" from dist-desktop
release/

# Editor/OS noise
.DS_Store
Thumbs.db

# Local Claude Code session config - machine-specific, not project source
.claude/
